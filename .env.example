# Copy to .env locally. Never paste the real key into chat, browser code or Git.
PROMPTWISE_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
# Local: attempts per server run. Hosted: persistent lifetime attempt allowance.
# Not actual billing; check provider usage independently.
PROMPTWISE_AI_MAX_CALLS=50
# Keep local by default. Public AI requires explicit hosted configuration below.
HOST=127.0.0.1
PORT=4173

# Hosted demo only: Render environment variables, not the local .env.
# Leave false on this Mac. This is shared demo access, not student accounts.
PROMPTWISE_HOSTED=false
# Hosted demos default to public access while retaining persistent AI limits.
PROMPTWISE_DEMO_ACCESS=public
# Optional: set DEMO_ACCESS=password and a generated 32+ character password.
# Username in password mode is demo. Unused in public mode.
PROMPTWISE_DEMO_PASSWORD=
# Render supplies RENDER_EXTERNAL_HOSTNAME automatically. For other reverse
# proxies, set a plain HTTPS origin and forward Host and X-Forwarded-Proto.
PROMPTWISE_PUBLIC_ORIGIN=
# Mount a persistent disk here BEFORE enabling hosted AI.
PROMPTWISE_DATA_DIR=
# Conservative lifetime reservations, not actual provider billing or a guaranteed
# OpenAI dollar cap. Does not reset automatically on restart, day or month.
PROMPTWISE_AI_BUDGET_USD=5
