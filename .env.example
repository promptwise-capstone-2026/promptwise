# Copy to .env locally. Never paste the real key into chat, browser code or Git.
PROMPTWISE_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
# Attempts per server run, not a dollar limit. Check provider usage before restarting.
PROMPTWISE_AI_MAX_CALLS=50
# Keep local by default. Remote AI calls are denied even if HOST changes.
HOST=127.0.0.1
PORT=4173
